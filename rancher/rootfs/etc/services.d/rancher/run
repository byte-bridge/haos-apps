#!/usr/bin/with-contenv bashio
# ==============================================================================
# HAOS Rancher - runs the official rancher/rancher container
# ==============================================================================
declare -a docker_args
declare bootstrap_password
declare http_port
declare https_port
declare rancher_version
declare server_url

bashio::log.info "Starting Rancher container..."

rancher_version="$(bashio::config 'rancher_version')"
http_port="$(bashio::config 'http_port')"
https_port="$(bashio::config 'https_port')"

if bashio::config.true 'reset_data'; then
    bashio::log.warning "reset_data is enabled — wiping hassio_addon_rancher_data"
    docker rm -f hassio-rancher >/dev/null 2>&1 || true
    docker volume rm hassio_addon_rancher_data >/dev/null 2>&1 || true
    docker volume create hassio_addon_rancher_data
    bashio::log.info "Reset complete — turning off reset_data in app options"
    bashio::addon.option 'reset_data' '^false' || \
        bashio::log.warning "Could not clear reset_data automatically; disable it in app options"
fi

# After a failed/partial k3s start, Rancher's entrypoint re-runs --cluster-reset.
# k3s refuses unless this file is gone:
# /var/lib/rancher/k3s/server/db/reset-flag
bashio::log.info "Clearing leftover k3s cluster-reset flag (if present)..."
docker run --rm \
    --entrypoint /bin/sh \
    -v hassio_addon_rancher_data:/var/lib/rancher \
    "rancher/rancher:${rancher_version}" \
    -c 'rm -f /var/lib/rancher/k3s/server/db/reset-flag' \
    >/dev/null 2>&1 || true

# Official single-node Docker install (Option E — no certificate):
# https://ranchermanager.docs.rancher.com/getting-started/installation-and-upgrade/other-installation-methods/rancher-on-a-single-node-with-docker/
#   docker run --privileged -p 80:80 -p 443:443 rancher/rancher --no-cacerts
# Home Assistant Ingress terminates TLS, so we do not mount certs.
docker_args+=(
    run
    --name hassio-rancher
    --privileged
    --pull always
    -v hassio_addon_rancher_data:/var/lib/rancher
    -p "127.0.0.1:${http_port}:80"
    -p "127.0.0.1:${https_port}:443"
)

if bashio::config.has_value 'bootstrap_password'; then
    bootstrap_password="$(bashio::config 'bootstrap_password')"
    docker_args+=(-e "CATTLE_BOOTSTRAP_PASSWORD=${bootstrap_password}")
fi

if bashio::config.has_value 'server_url'; then
    server_url="$(bashio::config 'server_url')"
    docker_args+=(-e "CATTLE_SERVER_URL=${server_url}")
fi

docker_args+=("rancher/rancher:${rancher_version}" --no-cacerts)

bashio::log.info "Launching rancher/rancher:${rancher_version}..."

docker rm -f hassio-rancher >/dev/null 2>&1 || true
exec docker "${docker_args[@]}"
