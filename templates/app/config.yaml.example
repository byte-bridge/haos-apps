# https://developers.home-assistant.io/docs/apps/configuration
name: Example App
version: "0.0.0"
slug: example-app
description: "Template app — copy this folder to create a new app"
url: "https://github.com/byte-bridge/haos-apps/tree/main/templates/app"
arch:
  - aarch64
  - amd64
startup: application
init: false
panel_icon: mdi:puzzle
options:
  log_level: info
schema:
  log_level: list(trace|debug|info|notice|warning|error|fatal)?
image: "ghcr.io/home-assistant/amd64-base"  # Replace with your Dockerfile build or upstream image
